# ========================================================
# EcoTrack - Docker Compose Environment Configuration
# ========================================================

# 1. Database (PostgreSQL)
POSTGRES_DB=ecotrack
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=ecotrack_secret
POSTGRES_PORT=5432

# 2. Backend Gateway (Express.js)
PORT=5000
DATABASE_URL=postgresql://ecotrack:ecotrack_secret@localhost:5432/ecotrack?schema=public
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-internal-token

# 3. AI Service (FastAPI)
AI_PORT=8000
TARIFF_RATE_VND=3100

# LLM Providers (Configure at least one for Copilot Agent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 4. Frontend (React 18 + Vite)
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000
