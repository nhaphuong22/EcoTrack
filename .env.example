# ========================================================
# EcoTrack - Root Docker Compose Configuration
# ========================================================
# Root .env controls PostgreSQL and host port mappings.
# Service-specific variables are loaded directly from:
#   - ai-service/.env
#   - backend/.env
#   - frontend/.env

# 1. Database (PostgreSQL)
POSTGRES_DB=ecotrack
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=ecotrack_secret
POSTGRES_PORT=5432

# 2. Host Port Mappings
AI_PORT=8000
PORT=5000
FRONTEND_PORT=3000
