PORT=5000
DATABASE_URL=postgresql://ecotrack:ecotrack_secret@localhost:5432/ecotrack?schema=public
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-internal-token
INGEST_API_KEY=replace-with-a-random-ingest-key
OPERATOR_API_KEY=replace-with-a-different-random-operator-key
MLOPS_STATUS_CACHE_TTL_SECONDS=5
MLOPS_RETRAIN_RATE_LIMIT_PER_MINUTE=3
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
APP_FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Email mời cư dân vào hộ gia đình. Bỏ trống SMTP_HOST/SMTP_FROM để tắt gửi mail
# (API vẫn trả mã mời để quản lý chuyển tay).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailbox@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=EcoTrack <your-mailbox@gmail.com>
SMTP_REPLY_TO=
